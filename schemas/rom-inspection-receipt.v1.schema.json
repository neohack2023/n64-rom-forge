{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROM Inspection Receipt v1",
  "type": "object",
  "required": ["schema", "source", "normalized_view", "header", "ipl3"],
  "properties": {
    "schema": {"const": "n64rf.rom-inspection-receipt.v1"},
    "source": {
      "type": "object",
      "required": ["path_label", "size_bytes", "wrapper_open_mode", "magic_hex", "detected_byte_order", "sha1", "sha256"],
      "properties": {
        "wrapper_open_mode": {"const": "rb"},
        "detected_byte_order": {"enum": ["z64", "v64", "n64"]},
        "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": true
    },
    "normalized_view": {"type": "object"},
    "header": {"type": "object"},
    "ipl3": {"type": "object"}
  },
  "additionalProperties": true
}
