{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROM Inspection Receipt v1",
  "type": "object",
  "required": ["schema", "path_label", "size_bytes", "sha1", "sha256", "byte_order", "wrapper_open_mode", "header", "ipl3", "normalized_sha1", "normalized_sha256"],
  "properties": {
    "schema": {"const": "n64rf.rom-inspection-receipt.v1"},
    "path_label": {"type": "string"},
    "size_bytes": {"type": "integer", "minimum": 1},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_order": {"enum": ["z64", "v64", "n64", "unknown"]},
    "filesystem_mode_octal": {"type": "string"},
    "filesystem_writable": {"type": "boolean"},
    "wrapper_open_mode": {"const": "rb"},
    "read_only": {"type": "boolean"},
    "header": {"type": "object"},
    "ipl3": {"type": "object"},
    "normalized_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "normalized_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
